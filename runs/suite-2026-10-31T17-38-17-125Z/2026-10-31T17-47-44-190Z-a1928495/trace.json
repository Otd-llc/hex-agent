        "head": "{\"total\":22,\"parts\":[{\"value\":\"hex-acc-bracket\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"L bracket\",\"use\":\"Back plate on the flat, shelf on top, gusset underneath: the part to bolt on when something has to stick out sideways and stay level.\",\"boxMm\":{\"x\":90,\"y\":76,\"z\":48}},{\"value\":\"hex-acc-rod\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Rod socket\",\"use\":\"Stands a round tube up off a cell face, so a mast, a stake or a conduit riser is carried by the cluster.\",\"boxMm\":{\"x\":48,\"y\":76,\"z\":46}},{\"value\":\"hex-acc-foot\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Leveling foot\",\"use\":\"Puts a captive nut on a face so a bought leveling bolt can take the weight, which is how a cluster gets level on ground that is not.\",\"boxMm\":{\"x\":48,\"y\":76,\"z\":18.5}},{\"value\":\"hex-acc-anchor\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Ground anchor\",\"use\":\"Pins a cell to the ground through a hole sized for a stake or a heavy screw, for a build that has to stay where you put it.\",\"boxMm\":{\"x\":48,\"y\":78,\"z\":74}},{\"value\":\"hex-acc-hook\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Hook plate\",\"use\":\"Each plate carries two hooks side by side, so you bolt on as many as you want where you want them rather than committing a whole face to a rail.\",\"boxMm\":{\"x\":48,\"y\":76,\"z\":40}},{\"value\":\"hex-acc-splice\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Story splice\",\"use\":\"Ties two stacked cells across the joint line, the one accessory that reaches past its own story.\",\"boxMm\":{\"x\":48,\"y\":136,\"z\":21}},{\"value\":\"hex-acc-keyhole\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Keyhole hanger\",\"use\":\"Hangs a cell on screws that are alr