# Meta Model API key (https://dev.meta.ai). Standard-mode models only.
MODEL_API_KEY=
# The Meta Model API is off unless this is 1: its credit is for the demo and judging (owner OK only).
META_API_ALLOWED=
# Optional: browser channel for Playwright (default: system Chrome).
# HEX_BROWSER_CHANNEL=chrome
# Credit guard (USD). Dev and eval stop at their caps and never touch the reserve;
# only --purpose=demo may spend the reserve, which is held for judging.
SPEND_CREDIT_USD=150
SPEND_RESERVE_USD=50
SPEND_CAP_DEV_USD=45
SPEND_CAP_EVAL_USD=40
# Claude API, for development and a labeled baseline only (never --purpose=demo).
# Unset is fine if `ant auth login` has a profile. Its credit has no reserve.
ANTHROPIC_API_KEY=
CLAUDE_CREDIT_USD=100
# Baseten Model API: Muse Spark Open (Meta open weights), pay-per-token.
BASETEN_API_KEY=
BASETEN_CREDIT_USD=100
BASETEN_RESERVE_USD=0
# Fireworks serverless: Muse Spark Open, pay-per-token
# (--model=accounts/fireworks/models/muse-spark-open). Set the credit you have.
FIREWORKS_API_KEY=
FIREWORKS_CREDIT_USD=
FIREWORKS_RESERVE_USD=0
# Modal Shared Endpoint (per token): a proxy token from `modal workspace proxy-tokens create`,
# and --model=modal:<endpoint host from the dashboard>. A Dedicated Endpoint bills GPU
# time and needs the owner's OK before it is made.
MODAL_PROXY_TOKEN=
MODAL_CREDIT_USD=
MODAL_RESERVE_USD=0
