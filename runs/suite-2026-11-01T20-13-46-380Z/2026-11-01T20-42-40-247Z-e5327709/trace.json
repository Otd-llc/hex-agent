      "result": {
        "clipped": true,
        "head": "{\"total\":22,\"parts\":[{\"value\":\"hex-acc-bracket\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"L bracket\",\"use\":\"Back plate on the flat, shelf on top, gusset underneath: the part to bolt on when something has to stick out sideways and stay level.\",\"boxMm\":{\"x\":90,\"y\":76,\"z\":48}},{\"value\":\"hex-acc-rod\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Rod socket\",\"use\":\"Stands a round tube up off a cell face, so a mast, a stake or a conduit riser is carried by the cluster.\",\"boxMm\":{\"x\":48,\"y\":76,\"z\":46}},{\"value\":\"hex-acc-foot\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Leveling foot\",\"use\":\"Puts a captive nut on a face so a bought leveling bolt can take the weight, which is how a cluster gets level on ground that is not.\",\"boxMm\":{\"x\":48,\"y\":76,\"z\":18.5}},{\"value\":\"hex-acc-anchor\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Ground anchor\",\"use\":\"Pins a cell to the ground through a hole sized for a stake or a heavy screw, for a build that has to stay where you put it.\",\"boxMm\":{\"x\":48,\"y\":78,\"z\":74}},{\"value\":\"hex-acc-hook\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Hook plate\",\"use\":\"Each plate carries two hooks side by side, so you bolt on as many as you want where you want them rather than committing a whole face to a rail.\",\"boxMm\":{\"x\":48,\"y\":76,\"z\":40}},{\"value\":\"hex-acc-splice\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Story splice\",\"use\":\"Ties two stacked cells across the joint line, the one accessory that reaches past its own story.\",\"boxMm\":{\"x\":48,\"y\":136,\"z\":21}},{\"value\":\"hex-acc-keyhole\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Keyhole hanger\",\"use\":\"Hangs a cell on screws that are already in a wall, so mounting is a lift and a drop rather than a drilling job through the cluster.\",\"boxMm\":{\"x\":48,\"y\":80,\"z\":6}},{\"value\":\"hex-acc-comb\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Cable comb\",\"use\":\"A block of teeth a cable pushes in between sideways, so a bundle is kept in order without anything to thread or undo.\",\"boxMm\":{\"x\":48,\"y\":56,\"z\":25}},{\"value\":\"hex-acc-handle\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Grab handle\",\"use\":\"A bar standing off the flat with room for a hand behind it, for a cell or a column that gets moved by its side rather than its top.\",\"boxMm\":{\"x\":48,\"y\":56,\"z\":32}},{\"value\":\"hex-acc-saddle\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Pipe saddle, 3/4 in\",\"use\":\"A cradle that carries a run of rigid pipe against a cell, sized by nominal pipe size and closed with a cable tie, so the pipe is held by the cluster instead ...\",\"boxMm\":{\"x\":48,\"y\":56,\"z\":25.585}},{\"value\":\"hex-acc-saddle-half\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Pipe saddle, 1/2 in\",\"use\":\"A cradle that carries a run of rigid pipe against a cell, sized by nominal pipe size and closed with a cable tie, so the pipe is held by the cluster instead ...\",\"boxMm\":{\"x\":48,\"y\":56,\"z\":22.918}},{\"value\":\"hex-acc-saddle-one\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Pipe saddle, 1 in\",\"use\":\"A cradle that carries a run of rigid pipe against a cell, sized by nominal pipe size and closed with a cable tie, so the pipe is held by the cluster instead ...\",\"boxMm\":{\"x\":48,\"y\":56,\"z\":28.951}},{\"value\":\"hex-acc-cascade\",\"op\":\"addAccessory\",\"field\":\"stem\",\"family\":\"accessory\",\"name\":\"Cascade pocket\",\"use\":\"A pocket that bolts to a cell's side flat and hangs one story down, so what i